{
  "type": "APL",
  "version": "2024.2",
  "theme": "dark",
  "extensions": [
    {
      "name": "DataStore",
      "uri": "alexaext:datastore:10"
    }
  ],
  "settings": {
    "DataStore": {
      "dataBindings": [
        {
          "namespace": "hadithOfTheDay",
          "key": "hadith",
          "dataBindingName": "DS_Hadith",
          "dataType": "OBJECT"
        }
      ]
    }
  },
  "import": [
    {
      "name": "alexa-layouts",
      "version": "1.7.0"
    }
  ],
  "mainTemplate": {
    "parameters": ["payload"],
    "item": {
      "type": "TouchWrapper",
      "width": "100vw",
      "height": "100vh",
      "bind": [
        {
          "name": "updateTime",
          "value": "${DS_Hadith.nextUpdateTime != null ? DS_Hadith.nextUpdateTime : payload.hadith.nextUpdateTime}",
          "type": "number"
        }
      ],
      "onMount": [
        {
          "type": "DataStore:WatchObject",
          "namespace": "hadithOfTheDay",
          "key": "hadith"
        },
        {
          "type": "Idle",
          "delay": 1000
        },
        {
          "type": "SendEvent",
          "arguments": ["FETCH_NEW_HADITH", "${updateTime}"],
          "flags": {
            "interactionMode": "STANDARD"
          }
        }
      ],
      "onPress": [
        {
          "type": "SendEvent",
          "arguments": [
            "READ_HADITH",
            "${DS_Hadith.content.hadithText ? DS_Hadith.content.hadithText : payload.hadith.content.hadithText}"
          ],
          "flags": {
            "interactionMode": "STANDARD"
          }
        }
      ],
      "item": {
        "type": "Container",
        "width": "100%",
        "height": "100%",
        "items": [
          {
            "type": "AlexaBackground",
            "backgroundImageSource": "https://cdn.mawaqit.net/images/background-arabic-calligraphy.png",
            "backgroundScale": "best-fill"
          },
          {
            "type": "Container",
            "position": "absolute",
            "width": "100%",
            "height": "100%",
            "paddingLeft": "20dp",
            "paddingRight": "20dp",
            "paddingTop": "18dp",
            "paddingBottom": "18dp",
            "direction": "column",
            "items": [
              {
                "type": "Text",
                "text": "${DS_Hadith.labels.title ? DS_Hadith.labels.title : payload.hadith.labels.title}",
                "fontSize": "16dp",
                "fontWeight": "300",
                "color": "#d5e0dc",
                "paddingBottom": "10dp",
                "maxLines": 1
              },
              {
                "type": "ScrollView",
                "width": "100%",
                "grow": 1,
                "item": {
                  "type": "Text",
                  "text": "${DS_Hadith.content.hadithText ? DS_Hadith.content.hadithText : payload.hadith.content.hadithText}",
                  "fontSize": "16dp",
                  "fontWeight": "400",
                  "color": "#ffffff"
                }
              },
              {
                "type": "Text",
                "text": "MAWAQIT",
                "fontSize": "14dp",
                "fontWeight": "700",
                "color": "#d5e0dc",
                "paddingTop": "10dp",
                "maxLines": 1
              }
            ]
          }
        ]
      }
    }
  }
}
