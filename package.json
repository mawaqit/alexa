{
  "name": "mawaqit-alexa",
  "private": true,
  "description": "Tooling workspace for the MAWAQIT Alexa skill (lambda + azan-lambda)",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepare": "husky",
    "deploy:dev": "pnpm --filter ./lambda deploy:dev && pnpm --filter ./azan-lambda deploy:dev && pnpm push:skill-config && pnpm push:account-linking-config",
    "deploy:prod": "pnpm --filter ./lambda deploy:prod && pnpm --filter ./azan-lambda deploy:prod",
    "push:skill-config": "ask deploy --target skill-metadata --profile ${ASK_PROFILE:-MAWAQIT}",
    "push:account-linking-config": "node .ask/push-account-linking.js",
    "sync:locales": "node .ask/sync-locales.js"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "prettier": "^3.4.2"
  }
}
