{
  "name": "mawaqit-alexa",
  "private": true,
  "version": "1.0.0",
  "description": "Tooling workspace for the MAWAQIT Alexa skill (lambda + azan-lambda)",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint lambda azan-lambda",
    "lint:fix": "eslint lambda azan-lambda --fix",
    "format": "prettier --write \"{lambda,azan-lambda}/**/*.js\"",
    "format:check": "prettier --check \"{lambda,azan-lambda}/**/*.js\"",
    "prepare": "husky",
    "deploy:dev": "pnpm --filter ./lambda deploy:dev && pnpm --filter ./azan-lambda deploy:dev && pnpm push:interaction-models",
    "deploy:prod": "pnpm --filter ./lambda deploy:prod && pnpm --filter ./azan-lambda deploy:prod",
    "push:interaction-models": "bash scripts/push-interaction-models.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "prettier": "^3.4.2"
  }
}
