{
    "type": "APL",
    "version": "2024.2",
    "theme": "dark",
    "description": "Next prayer widget. Displays prayer name, live countdown, and handles a fetching state using the display property.",
    "extensions": [
        {
            "name": "DataStore",
            "uri": "alexaext:datastore:10"
        }
    ],
    "settings": {
        "DataStore": {
            "dataBindings": [
                {
                    "namespace": "nextPrayerTimeWidget",
                    "key": "nextPrayerData",
                    "dataBindingName": "DS_PrayerTime",
                    "dataType": "OBJECT"
                }
            ]
        }
    },
    "import": [
        {
            "name": "alexa-layouts",
            "version": "1.7.0"
        }
    ],
    "resources": [
        {
            "description": "Artwork owned by the presentation layer.",
            "strings": {
                "pageBackground": "https://cdn.mawaqit.net/images/background-arabic-calligraphy.png",
                "logoUrl": "https://play-lh.googleusercontent.com/79-OHFiVzGLTSLg_tXcsS3VwxWd9ZAxL4eAt35IgIljERyMkYvAq92m-fgpDsZ-lNA"
            }
        },
        {
            "description": "Palette matching mosqueInfoApl.json.",
            "colors": {
                "colorGlass": "#FFFFFF14",
                "colorStroke": "#FFFFFF2B",
                "colorTextPrimary": "#F7F5FF",
                "colorTextMuted": "#FFFFFFA3",
                "colorAccent": "#F2C86B",
                "colorAccentSoft": "#F2C86B24",
                "colorDivider": "#FFFFFF1F"
            },
            "gradients": {
                "gradientPage": {
                    "type": "linear",
                    "colorRange": [
                        "#0B0A1FD9",
                        "#0B0A1FF2",
                        "#150F33E6"
                    ],
                    "inputRange": [
                        0,
                        0.55,
                        1
                    ]
                }
            }
        },
        {
            "description": "Metrics — medium widget.",
            "dimensions": {
                "padH": "22dp",
                "padV": "20dp",
                "brandLogo": "22dp",
                "ruleWidth": "56dp"
            },
            "numbers": {
                "fsLabel": 15,
                "fsPrayer": 32,
                "fsCountdown": 58,
                "fsCaption": 14,
                "fsSecondary": 24,
                "fsMosque": 15,
                "fsBrand": 13
            }
        },
        {
            "when": "${viewport.width < 340}",
            "description": "Metrics — compact widget.",
            "dimensions": {
                "padH": "16dp",
                "padV": "14dp",
                "brandLogo": "18dp",
                "ruleWidth": "40dp"
            },
            "numbers": {
                "fsLabel": 13,
                "fsPrayer": 24,
                "fsCountdown": 44,
                "fsCaption": 12,
                "fsSecondary": 19,
                "fsMosque": 13,
                "fsBrand": 11
            }
        }
    ],
    "styles": {
        "widgetLabel": {
            "values": [
                {
                    "fontFamily": "Amazon Ember",
                    "fontSize": "@fsLabel",
                    "fontWeight": 500,
                    "letterSpacing": "1.4dp",
                    "color": "@colorTextMuted",
                    "maxLines": 1
                }
            ]
        },
        "prayerName": {
            "values": [
                {
                    "fontFamily": "Amazon Ember Display",
                    "fontSize": "@fsPrayer",
                    "fontWeight": 700,
                    "letterSpacing": "2dp",
                    "color": "@colorTextPrimary",
                    "maxLines": 1
                }
            ]
        },
        "countdown": {
            "values": [
                {
                    "fontFamily": "Amazon Ember Display",
                    "fontSize": "@fsCountdown",
                    "fontWeight": 700,
                    "color": "@colorAccent",
                    "maxLines": 1,
                    "adjustsFontSizeToFit": true,
                    "minimumFontSize": 24
                }
            ]
        },
        "caption": {
            "values": [
                {
                    "fontFamily": "Amazon Ember",
                    "fontSize": "@fsCaption",
                    "fontWeight": 500,
                    "letterSpacing": "1.8dp",
                    "color": "@colorAccent",
                    "opacity": 0.75,
                    "maxLines": 1
                }
            ]
        },
        "secondaryTime": {
            "values": [
                {
                    "fontFamily": "Amazon Ember Display",
                    "fontSize": "@fsSecondary",
                    "fontWeight": 700,
                    "color": "@colorTextPrimary",
                    "maxLines": 1
                }
            ]
        },
        "preposition": {
            "values": [
                {
                    "fontFamily": "Amazon Ember",
                    "fontSize": "@fsMosque",
                    "fontWeight": 400,
                    "color": "@colorTextMuted",
                    "maxLines": 1
                }
            ]
        },
        "mosqueName": {
            "values": [
                {
                    "fontFamily": "Amazon Ember",
                    "fontSize": "@fsMosque",
                    "fontWeight": 400,
                    "color": "@colorTextMuted",
                    "maxLines": 1
                }
            ]
        },
        "brandLabel": {
            "values": [
                {
                    "fontFamily": "Amazon Ember",
                    "fontSize": "@fsBrand",
                    "fontWeight": 500,
                    "letterSpacing": "1.6dp",
                    "color": "@colorTextMuted",
                    "maxLines": 1
                }
            ]
        }
    },
    "layouts": {
        "PageBackdrop": {
            "items": [
                {
                    "type": "Container",
                    "items": [
                        {
                            "type": "Image",
                            "source": "@pageBackground",
                            "scale": "best-fill",
                            "align": "center",
                            "width": "100%",
                            "height": "100%"
                        },
                        {
                            "type": "Frame",
                            "position": "absolute",
                            "top": 0,
                            "left": 0,
                            "right": 0,
                            "bottom": 0,
                            "background": "@gradientPage"
                        }
                    ]
                }
            ]
        },
        "BrandMark": {
            "items": [
                {
                    "type": "Container",
                    "direction": "row",
                    "alignItems": "center",
                    "width": "100%",
                    "items": [
                        {
                            "type": "Image",
                            "source": "@logoUrl",
                            "width": "@brandLogo",
                            "height": "@brandLogo",
                            "scale": "best-fill",
                            "borderRadius": "5dp"
                        },
                        {
                            "type": "Text",
                            "style": "brandLabel",
                            "text": "MAWAQIT",
                            "paddingLeft": "8dp"
                        }
                    ]
                }
            ]
        }
    },
    "mainTemplate": {
        "parameters": [
            "payload"
        ],
        "item": {
            "type": "TouchWrapper",
            "id": "mainWidget",
            "width": "100vw",
            "height": "100vh",
            "bind": [
                {
                    "name": "labels",
                    "value": "${DS_PrayerTime.labels ? DS_PrayerTime.labels : payload.nextPrayerData.labels}"
                },
                {
                    "name": "data",
                    "value": "${DS_PrayerTime.data ? DS_PrayerTime.data : payload.nextPrayerData.data}"
                },
                {
                    "name": "targetTime",
                    "value": "${DS_PrayerTime.nextUpdateTime != null ? DS_PrayerTime.nextUpdateTime : payload.nextPrayerData.nextUpdateTime}",
                    "type": "number"
                },
                {
                    "name": "diffMs",
                    "value": "${Math.max(0, targetTime - utcTime)}",
                    "type": "number"
                },
                {
                    "name": "hrs",
                    "value": "${Math.floor(diffMs / 3600000)}",
                    "type": "number"
                },
                {
                    "name": "mins",
                    "value": "${Math.floor((diffMs % 3600000) / 60000)}",
                    "type": "number"
                }
            ],
            "onMount": [
                {
                    "type": "DataStore:WatchObject",
                    "namespace": "nextPrayerTimeWidget",
                    "key": "nextPrayerData"
                },
                {
                    "type": "Idle",
                    "delay": 500
                },
                {
                    "type": "SendEvent",
                    "arguments": [
                        "FETCH_PRAYER_TIME",
                        "${targetTime}"
                    ]
                }
            ],
            "onPress": [
                {
                    "type": "SendEvent",
                    "arguments": [
                        "READ_PRAYER_TIME"
                    ],
                    "flags": {
                        "interactionMode": "STANDARD"
                    }
                }
            ],
            "item": {
                "type": "Container",
                "width": "100%",
                "height": "100%",
                "items": [
                    {
                        "type": "PageBackdrop"
                    },
                    {
                        "type": "Container",
                        "position": "absolute",
                        "width": "100%",
                        "height": "100%",
                        "paddingLeft": "@padH",
                        "paddingRight": "@padH",
                        "paddingTop": "@padV",
                        "paddingBottom": "@padV",
                        "items": [
                            {
                                "type": "Container",
                                "direction": "row",
                                "width": "100%",
                                "justifyContent": "spaceBetween",
                                "items": [
                                    {
                                        "type": "Text",
                                        "style": "widgetLabel",
                                        "text": "${labels.title}"
                                    },
                                    {
                                        "type": "Text",
                                        "style": "widgetLabel",
                                        "text": "${Time.format('HH:mm', localTime)}"
                                    }
                                ]
                            },
                            {
                                "type": "Container",
                                "display": "${targetTime == 0 ? 'normal' : 'none'}",
                                "grow": 1,
                                "shrink": 1,
                                "width": "100%",
                                "justifyContent": "center",
                                "alignItems": "center",
                                "items": [
                                    {
                                        "type": "Text",
                                        "style": "secondaryTime",
                                        "text": "Fetching...",
                                        "color": "@colorAccent",
                                        "textAlign": "center",
                                        "width": "100%"
                                    }
                                ]
                            },
                            {
                                "type": "Container",
                                "display": "${targetTime > 0 ? 'normal' : 'none'}",
                                "grow": 1,
                                "shrink": 1,
                                "width": "100%",
                                "justifyContent": "center",
                                "alignItems": "center",
                                "items": [
                                    {
                                        "type": "Text",
                                        "style": "prayerName",
                                        "text": "${String.toUpperCase(data.nextPrayerName)}",
                                        "textAlign": "center",
                                        "width": "100%"
                                    },
                                    {
                                        "type": "Text",
                                        "style": "countdown",
                                        "text": "${diffMs <= 0 ? labels.itsTime : (hrs > 0 ? hrs + ' ' + labels.hourUnit + ' ' : '') + mins + ' ' + labels.minuteUnit}",
                                        "textAlign": "center",
                                        "paddingTop": "2dp"
                                    },
                                    {
                                        "type": "Text",
                                        "style": "caption",
                                        "text": "${labels.remaining} ${labels.at}",
                                        "display": "${diffMs > 0 ? 'normal' : 'none'}",
                                        "textAlign": "center",
                                        "paddingTop": "6dp"
                                    },
                                    {
                                        "type": "Text",
                                        "style": "secondaryTime",
                                        "text": "${data.nextPrayerTime}",
                                        "display": "${diffMs > 0 ? 'normal' : 'none'}",
                                        "textAlign": "center",
                                        "paddingTop": "2dp"
                                    }
                                ]
                            },
                            {
                                "type": "Container",
                                "display": "${targetTime > 0 ? 'normal' : 'none'}",
                                "width": "100%",
                                "alignItems": "center",
                                "items": [
                                    {
                                        "type": "Frame",
                                        "width": "@ruleWidth",
                                        "height": "1dp",
                                        "background": "@colorDivider"
                                    },
                                    {
                                        "type": "Text",
                                        "style": "mosqueName",
                                        "text": "${data.mosqueName}",
                                        "textAlign": "center",
                                        "width": "100%",
                                        "paddingTop": "8dp"
                                    }
                                ]
                            },
                            {
                                "type": "BrandMark",
                                "paddingTop": "12dp"
                            }
                        ]
                    }
                ]
            }
        }
    }
}