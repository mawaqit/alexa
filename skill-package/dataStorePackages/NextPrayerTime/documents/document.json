{
  "type": "APL",
  "version": "2024.2",
  "theme": "dark",
  "extensions": [
    {
      "name": "DataStore",
      "uri": "alexaext:datastore:10"
    }
  ],
  "settings": {
    "DataStore": {
      "dataBindings": [
        {
          "namespace": "nextPrayerTimeWidget",
          "key": "nextPrayerData",
          "dataBindingName": "DS_PrayerTime",
          "dataType": "OBJECT"
        }
      ]
    }
  },
  "import": [
    {
      "name": "alexa-layouts",
      "version": "1.7.0"
    }
  ],
  "mainTemplate": {
    "parameters": ["payload"],
    "item": {
      "type": "TouchWrapper",
      "width": "100vw",
      "height": "100vh",
      "onMount": [
        {
          "type": "DataStore:WatchObject",
          "namespace": "nextPrayerTimeWidget",
          "key": "nextPrayerData"
        },
        {
          "type": "SendEvent",
          "arguments": ["FETCH_PRAYER_TIME", "${DS_PrayerTime.nextUpdateTime}"]
        }
      ],
      "onPress": [
        {
          "type": "SendEvent",
          "arguments": ["READ_PRAYER_TIME"]
        }
      ],
      "item": {
        "type": "Container",
        "width": "100%",
        "height": "100%",
        "items": [
          {
            "type": "AlexaBackground",
            "backgroundImageSource": "https://cdn.mawaqit.net/images/background-arabic-calligraphy.png",
            "backgroundScale": "best-fill"
          },
          {
            "type": "Container",
            "position": "absolute",
            "width": "100%",
            "height": "100%",
            "paddingLeft": "20dp",
            "paddingRight": "20dp",
            "paddingTop": "18dp",
            "paddingBottom": "18dp",
            "direction": "column",
            "items": [
              {
                "type": "Text",
                "text": "${DS_PrayerTime.labels.title ? DS_PrayerTime.labels.title : payload.nextPrayerData.labels.title}",
                "fontSize": "16dp",
                "fontWeight": "300",
                "color": "#d5e0dc",
                "maxLines": 1
              },
              {
                "type": "Container",
                "grow": 1,
                "width": "100%",
                "justifyContent": "center",
                "alignItems": "center",
                "items": [
                  {
                    "type": "Text",
                    "text": "${String.toUpperCase(DS_PrayerTime.content.nextPrayerName ? DS_PrayerTime.content.nextPrayerName : payload.nextPrayerData.content.nextPrayerName)}",
                    "fontSize": "40dp",
                    "fontWeight": "700",
                    "color": "#ffffff",
                    "textAlign": "center",
                    "maxLines": 2
                  },
                  {
                    "type": "Text",
                    "text": "${String.toUpperCase(DS_PrayerTime.labels.at ? DS_PrayerTime.labels.at : payload.nextPrayerData.labels.at)}",
                    "fontSize": "18dp",
                    "fontWeight": "300",
                    "color": "#d5e0dc",
                    "textAlign": "center",
                    "paddingTop": "6dp",
                    "paddingBottom": "6dp",
                    "maxLines": 1
                  },
                  {
                    "type": "Text",
                    "text": "${DS_PrayerTime.content.nextPrayerTime ? DS_PrayerTime.content.nextPrayerTime : payload.nextPrayerData.content.nextPrayerTime}",
                    "fontSize": "40dp",
                    "fontWeight": "700",
                    "color": "#ffffff",
                    "textAlign": "center",
                    "maxLines": 1
                  },
                  {
                    "type": "Text",
                    "text": "${DS_PrayerTime.content.mosqueName ? DS_PrayerTime.content.mosqueName : payload.nextPrayerData.content.mosqueName}",
                    "fontSize": "16dp",
                    "color": "#d5e0dc",
                    "textAlign": "center",
                    "paddingTop": "14dp",
                    "maxLines": 1
                  }
                ]
              },
              {
                "type": "Text",
                "text": "MAWAQIT",
                "fontSize": "14dp",
                "fontWeight": "700",
                "color": "#d5e0dc",
                "maxLines": 1
              }
            ]
          }
        ]
      }
    }
  }
}
